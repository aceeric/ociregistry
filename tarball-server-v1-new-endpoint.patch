diff --git a/impl/tarball_handler_test.go b/impl/tarball_handler_test.go
new file mode 100644
index 0000000..4e59afc
--- /dev/null
+++ b/impl/tarball_handler_test.go
@@ -0,0 +1,173 @@
+package impl
+
+import (
+	"bytes"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/aceeric/ociregistry/api"
+	"github.com/aceeric/ociregistry/api/models"
+	"github.com/aceeric/ociregistry/impl/cache"
+	"github.com/aceeric/ociregistry/impl/config"
+	"github.com/aceeric/ociregistry/impl/serialize"
+	"github.com/aceeric/ociregistry/mock"
+)
+
+const (
+	loopbackAddr = "127.0.0.1:40000"
+	remoteAddr   = "192.0.2.10:40000"
+)
+
+// tarballRegistry returns an OciRegistry for PUT /cmd/tarball tests with an empty cache, its
+// spool directory, and the bytes of a docker-save tarball with one linux/amd64 image.
+func tarballRegistry(t *testing.T) (*OciRegistry, string, []byte) {
+	t.Helper()
+	cache.ResetCache()
+	td := t.TempDir()
+	if err := serialize.CreateDirs(td, true); err != nil {
+		t.Fatal(err)
+	}
+	spool := t.TempDir()
+	r := NewOciRegistry(nil)
+	r.imagePath, r.pullTimeout, r.tarballSpoolDir = td, 5000, spool
+	r.platformOs, r.platformArch = "linux", "amd64"
+	path := filepath.Join(t.TempDir(), "image.tar")
+	img := mock.TarImage{Ref: "quay.io/org/app:v1", Os: "linux", Arch: "amd64", Layers: []string{"a layer"}}
+	if err := mock.DockerSaveTarball(path, img); err != nil {
+		t.Fatal(err)
+	}
+	b, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return r, spool, b
+}
+
+// putTarball sends PUT /cmd/tarball with the passed body, from the passed address, with the
+// passed bearer token if not empty, and returns the response.
+func putTarball(r *OciRegistry, body []byte, addr, token string, params models.CmdTarballParams) *httptest.ResponseRecorder {
+	req := httptest.NewRequest(http.MethodPut, "/cmd/tarball", bytes.NewReader(body))
+	req.RemoteAddr = addr
+	if token != "" {
+		req.Header.Set("Authorization", "Bearer "+token)
+	}
+	rec := httptest.NewRecorder()
+	r.CmdTarball(rec, req, params)
+	return rec
+}
+
+// outcome returns the outcome of the one manifest in a successful response, or "".
+func outcome(t *testing.T, rec *httptest.ResponseRecorder) cache.TarballOutcome {
+	t.Helper()
+	resp := tarballResponse{}
+	if err := json.Unmarshal(rec.Body.Bytes(), &resp); err != nil || len(resp.Results) != 1 {
+		return ""
+	}
+	return resp.Results[0].Outcome
+}
+
+// Tests PUT /cmd/tarball authorization: with no token only loopback requests are accepted,
+// and with a token every request must have it, loopback or not.
+func TestCmdTarballAuth(t *testing.T) {
+	r, _, tarball := tarballRegistry(t)
+	if rec := putTarball(r, tarball, remoteAddr, "", models.CmdTarballParams{}); rec.Code != http.StatusForbidden {
+		t.Errorf("no token, remote: expected 403, got %d", rec.Code)
+	}
+	if rec := putTarball(r, tarball, loopbackAddr, "", models.CmdTarballParams{}); rec.Code != http.StatusOK || outcome(t, rec) != cache.TarballLoaded {
+		t.Errorf("no token, loopback: expected 200 loaded, got %d %s", rec.Code, rec.Body.String())
+	}
+	if rec := putTarball(r, tarball, "[::1]:40000", "", models.CmdTarballParams{}); rec.Code != http.StatusOK {
+		t.Errorf("no token, IPv6 loopback: expected 200, got %d", rec.Code)
+	}
+
+	r.SetToken("s3cret")
+	for _, tst := range []struct{ addr, token string }{{loopbackAddr, ""}, {remoteAddr, ""}, {remoteAddr, "wrong"}, {remoteAddr, "s3cret "}} {
+		rec := putTarball(r, tarball, tst.addr, tst.token, models.CmdTarballParams{})
+		if rec.Code != http.StatusUnauthorized || rec.Header().Get("WWW-Authenticate") != "Bearer" {
+			t.Errorf("%s with token %q: expected 401 with WWW-Authenticate, got %d", tst.addr, tst.token, rec.Code)
+		}
+	}
+	if rec := putTarball(r, tarball, remoteAddr, "s3cret", models.CmdTarballParams{}); rec.Code != http.StatusOK || outcome(t, rec) != cache.TarballCached {
+		t.Errorf("right token, remote: expected 200 cached, got %d %s", rec.Code, rec.Body.String())
+	}
+}
+
+// Tests the PUT /cmd/tarball errors: a load already in progress, a tarball over the maximum
+// size, a body that isn't a tarball, and a resolve ref for more than one image. The spool
+// file is removed in every case.
+func TestCmdTarballErrors(t *testing.T) {
+	r, spool, tarball := tarballRegistry(t)
+	r.tarballSem <- struct{}{}
+	if rec := putTarball(r, tarball, loopbackAddr, "", models.CmdTarballParams{}); rec.Code != http.StatusTooManyRequests {
+		t.Errorf("load in progress: expected 429, got %d", rec.Code)
+	}
+	<-r.tarballSem
+
+	r.maxTarballSize = int64(len(tarball) - 1)
+	if rec := putTarball(r, tarball, loopbackAddr, "", models.CmdTarballParams{}); rec.Code != http.StatusRequestEntityTooLarge {
+		t.Errorf("too large: expected 413, got %d", rec.Code)
+	}
+	r.maxTarballSize = int64(len(tarball))
+	if rec := putTarball(r, tarball, loopbackAddr, "", models.CmdTarballParams{}); rec.Code != http.StatusOK {
+		t.Errorf("exactly the maximum: expected 200, got %d %s", rec.Code, rec.Body.String())
+	}
+	r.maxTarballSize = config.DefaultMaxTarballSize
+
+	if rec := putTarball(r, []byte("not a tarball"), loopbackAddr, "", models.CmdTarballParams{}); rec.Code != http.StatusBadRequest {
+		t.Errorf("not a tarball: expected 400, got %d", rec.Code)
+	}
+
+	path := filepath.Join(t.TempDir(), "two.tar")
+	mock.DockerSaveTarball(path,
+		mock.TarImage{Ref: "quay.io/org/a:1", Os: "linux", Arch: "amd64", Layers: []string{"a"}},
+		mock.TarImage{Ref: "quay.io/org/b:1", Os: "linux", Arch: "amd64", Layers: []string{"b"}})
+	two, _ := os.ReadFile(path)
+	ref := "quay.io/org/renamed:1"
+	if rec := putTarball(r, two, loopbackAddr, "", models.CmdTarballParams{ResolveRef: &ref}); rec.Code != http.StatusBadRequest {
+		t.Errorf("resolve ref for two images: expected 400, got %d", rec.Code)
+	}
+
+	if entries, _ := os.ReadDir(spool); len(entries) != 0 {
+		t.Errorf("the spool directory should be empty, has %d file(s)", len(entries))
+	}
+}
+
+// sentinelBody is a request body whose type shows whether a middleware replaced it.
+type sentinelBody struct{ *bytes.Reader }
+
+func (sentinelBody) Close() error { return nil }
+
+// Tests PUT /cmd/tarball through the request validator and the router, as the server chains
+// them: the validator accepts the binary body, and passes it on without reading it (a validator
+// that read it would replace it with a copy in memory).
+func TestCmdTarballRoute(t *testing.T) {
+	r, _, tarball := tarballRegistry(t)
+	swagger, err := api.GetSpec()
+	if err != nil {
+		t.Fatal(err)
+	}
+	swagger.Servers = nil
+	replaced := false
+	checkBody := func(next http.Handler) http.Handler {
+		return http.HandlerFunc(func(w http.ResponseWriter, req *http.Request) {
+			_, ok := req.Body.(sentinelBody)
+			replaced = !ok
+			next.ServeHTTP(w, req)
+		})
+	}
+	h := RequestValidator(swagger)(checkBody(api.Handler(r)))
+	req := httptest.NewRequest(http.MethodPut, "/cmd/tarball?resolveRef=quay.io/org/renamed:2", sentinelBody{bytes.NewReader(tarball)})
+	req.RemoteAddr = loopbackAddr
+	req.Header.Set("Content-Type", "application/octet-stream")
+	rec := httptest.NewRecorder()
+	h.ServeHTTP(rec, req)
+	if rec.Code != http.StatusOK || outcome(t, rec) != cache.TarballLoaded || !bytes.Contains(rec.Body.Bytes(), []byte("quay.io/org/renamed:2")) {
+		t.Fatalf("expected 200 with the image loaded under the resolve ref, got %d %s", rec.Code, rec.Body.String())
+	} else if replaced {
+		t.Fatal("the validator read the request body")
+	}
+}
diff --git a/impl/validator.go b/impl/validator.go
new file mode 100644
index 0000000..8976d43
--- /dev/null
+++ b/impl/validator.go
@@ -0,0 +1,18 @@
+package impl
+
+import (
+	"net/http"
+
+	"github.com/getkin/kin-openapi/openapi3"
+	"github.com/getkin/kin-openapi/openapi3filter"
+	middleware "github.com/oapi-codegen/nethttp-middleware"
+)
+
+// RequestValidator returns the middleware that validates requests against the passed OpenAPI
+// spec. It doesn't validate request bodies: the only one is the tarball sent to PUT
+// /cmd/tarball, and validating it would read all of it into memory before the handler runs.
+func RequestValidator(swagger *openapi3.T) func(http.Handler) http.Handler {
+	return middleware.OapiRequestValidatorWithOptions(swagger, &middleware.Options{
+		Options: openapi3filter.Options{ExcludeRequestBody: true},
+	})
+}
diff --git a/mock/tarball.go b/mock/tarball.go
new file mode 100644
index 0000000..048649a
--- /dev/null
+++ b/mock/tarball.go
@@ -0,0 +1,89 @@
+package mock
+
+import (
+	"archive/tar"
+	"compress/gzip"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"io"
+	"os"
+	"strings"
+)
+
+// TarImage is one image for DockerSaveTarball: its ref (e.g. quay.io/org/app:v1), platform,
+// and layer contents.
+type TarImage struct {
+	Ref    string
+	Os     string
+	Arch   string
+	Layers []string
+}
+
+// DockerSaveTarball writes a docker-save format tarball (as from 'docker save') with the passed
+// images to path, gzip-compressed if path ends in .tgz or .tar.gz. It's for tests: the images'
+// config blobs only have the platform fields, and the layers are the passed strings. A layer
+// shared by two images is stored once, as in a real docker save.
+func DockerSaveTarball(path string, images ...TarImage) error {
+	f, err := os.Create(path)
+	if err != nil {
+		return err
+	}
+	defer f.Close()
+	var w io.Writer = f
+	if strings.HasSuffix(path, ".tgz") || strings.HasSuffix(path, ".tar.gz") {
+		gz := gzip.NewWriter(f)
+		defer gz.Close()
+		w = gz
+	}
+	tw := tar.NewWriter(w)
+	defer tw.Close()
+	type dockerManifest struct {
+		Config   string
+		RepoTags []string
+		Layers   []string
+	}
+	manifests := []dockerManifest{}
+	written := map[string]bool{}
+	add := func(content []byte) (string, error) {
+		name := "blobs/sha256/" + sha256Hex(content)
+		if written[name] {
+			return name, nil
+		}
+		written[name] = true
+		return name, writeTarFile(tw, name, content)
+	}
+	for _, img := range images {
+		cfg, _ := json.Marshal(map[string]string{"os": img.Os, "architecture": img.Arch})
+		cfgName, err := add(cfg)
+		if err != nil {
+			return err
+		}
+		dm := dockerManifest{Config: cfgName, RepoTags: []string{img.Ref}}
+		for _, layer := range img.Layers {
+			name, err := add([]byte(layer))
+			if err != nil {
+				return err
+			}
+			dm.Layers = append(dm.Layers, name)
+		}
+		manifests = append(manifests, dm)
+	}
+	b, _ := json.Marshal(manifests)
+	return writeTarFile(tw, "manifest.json", b)
+}
+
+// sha256Hex returns the hex sha256 digest of b.
+func sha256Hex(b []byte) string {
+	sum := sha256.Sum256(b)
+	return hex.EncodeToString(sum[:])
+}
+
+// writeTarFile writes one regular file to the tar writer.
+func writeTarFile(tw *tar.Writer, name string, content []byte) error {
+	if err := tw.WriteHeader(&tar.Header{Name: name, Mode: 0644, Size: int64(len(content)), Typeflag: tar.TypeReg}); err != nil {
+		return err
+	}
+	_, err := tw.Write(content)
+	return err
+}
