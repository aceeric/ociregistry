+package config
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+// Tests resolving the token from each source, with white space trimmed, and the errors: more
+// than one source, an empty token, and an unreadable file.
+func TestResolveToken(t *testing.T) {
+	saved := config
+	defer func() { config = saved }()
+	file := filepath.Join(t.TempDir(), "token")
+	os.WriteFile(file, []byte("from-file\n"), 0600)
+	empty := filepath.Join(t.TempDir(), "empty")
+	os.WriteFile(empty, []byte("\n"), 0600)
+	t.Setenv("OCIREGISTRY_TEST_TOKEN", " from-env ")
+	tests := []struct {
+		cfg     Configuration
+		want    string
+		wantErr string
+	}{
+		{Configuration{}, "", ""},
+		{Configuration{Token: "literal"}, "literal", ""},
+		{Configuration{TokenFile: file}, "from-file", ""},
+		{Configuration{TokenEnv: "OCIREGISTRY_TEST_TOKEN"}, "from-env", ""},
+		{Configuration{Token: "literal", TokenEnv: "OCIREGISTRY_TEST_TOKEN"}, "", "only one"},
+		{Configuration{TokenFile: empty}, "", "empty"},
+		{Configuration{TokenEnv: "OCIREGISTRY_TEST_UNSET_TOKEN"}, "", "empty"},
+		{Configuration{TokenFile: filepath.Join(t.TempDir(), "missing")}, "", "unable to read"},
+	}
+	for _, tst := range tests {
+		config = tst.cfg
+		got, err := ResolveToken()
+		if got != tst.want || (tst.wantErr == "") != (err == nil) || (err != nil && !strings.Contains(err.Error(), tst.wantErr)) {
+			t.Errorf("%+v: expected %q / error %q, got %q / %v", tst.cfg, tst.want, tst.wantErr, got, err)
+		}
+	}
+}
+
+// Tests parsing sizes, with and without units, and that invalid ones are errors.
+func TestParseSize(t *testing.T) {
+	for size, want := range map[string]int64{"": 0, "1": 1, "1024": 1024, "1Ki": 1 << 10, "512Mi": 512 << 20, "10Gi": 10 << 30, "2Ti": 2 << 40} {
+		if got, err := parseSize(size); err != nil || got != want {
+			t.Errorf("%q: expected %d, got %d %v", size, want, got, err)
+		}
+	}
+	for _, size := range []string{"0", "-1", "Gi", "10G", "10gi", "1.5Gi", "abc", "99999999999Ti"} {
+		if _, err := parseSize(size); err == nil {
+			t.Errorf("%q: expected an error", size)
+		}
+	}
+}
+
+// Tests the tarball settings from the config file: the defaults, configured values, an
+// invalid size, and that the token is redacted.
+func TestTarballConfig(t *testing.T) {
+	saved := config
+	defer func() { config = saved }()
+	if err := SetConfigFromStr([]byte("")); err != nil {
+		t.Fatal(err)
+	}
+	if GetMaxTarballSize() != DefaultMaxTarballSize || GetTarballSpoolDir() != os.TempDir() {
+		t.Errorf("expected the defaults, got %d %q", GetMaxTarballSize(), GetTarballSpoolDir())
+	}
+	if err := SetConfigFromStr([]byte("maxTarballSize: 2Gi\ntarballSpoolDir: /spool\ntoken: s3cret\n")); err != nil {
+		t.Fatal(err)
+	}
+	if GetMaxTarballSize() != 2<<30 || GetTarballSpoolDir() != "/spool" {
+		t.Errorf("expected 2Gi and /spool, got %d %q", GetMaxTarballSize(), GetTarballSpoolDir())
+	}
+	if Redacted().Token != redactedValue || config.Token != "s3cret" {
+		t.Errorf("the token should be redacted only in the copy, got %q %q", Redacted().Token, config.Token)
+	}
+	if b, _ := Marshal("yaml"); strings.Contains(string(b), "s3cret") {
+		t.Error("the marshaled config must not have the token")
+	}
+	if err := SetConfigFromStr([]byte("maxTarballSize: 10G\n")); err == nil || !strings.Contains(err.Error(), "maxTarballSize") {
+		t.Errorf("expected an error naming maxTarballSize, got %v", err)
+	}
+}
+
+// Tests that a token option on the command line replaces all of the config file's token
+// options, and that without one the file's are kept.
+func TestMergeToken(t *testing.T) {
+	saved := config
+	defer func() { config = saved }()
+	config = Configuration{TokenEnv: "FILE_ENV"}
+	Merge(FromCmdLine{}, Configuration{})
+	if config.TokenEnv != "FILE_ENV" {
+		t.Errorf("expected the file's token env to be kept, got %q", config.TokenEnv)
+	}
+	Merge(FromCmdLine{TokenFile: true}, Configuration{TokenFile: "/run/secrets/token"})
+	if config.TokenEnv != "" || config.TokenFile != "/run/secrets/token" {
+		t.Errorf("expected only the command line's token file, got %+v", config)
+	}
+}
