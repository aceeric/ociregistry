+// tarballResponse is the body of a successful PUT /cmd/tarball.
+type tarballResponse struct {
+	Results []cache.TarballResult `json:"results"`
+}
+
+// PUT /cmd/tarball?resolveRef=...
+// Loads the images in the tarball sent as the request body into the cache, and returns the
+// outcome of each manifest as JSON (see cache.LoadTarball). The request must have the bearer
+// token if the server has one, or else be from the loopback address. One tarball loads at a
+// time: a request while another loads gets 429. The tarball is saved to a temp file first,
+// because the tarball reader needs random access, and the file is removed when done.
+func (r *OciRegistry) CmdTarball(w http.ResponseWriter, req *http.Request, params models.CmdTarballParams) {
+	defer func() {
+		if err := recover(); err != nil {
+			log.Errorf("handled panic: %s", err)
+		}
+	}()
+	if !r.authorized(w, req) {
+		return
+	}
+	select {
+	case r.tarballSem <- struct{}{}:
+		defer func() { <-r.tarballSem }()
+	default:
+		writeString(w, http.StatusTooManyRequests, "a tarball load is already in progress\n")
+		return
+	}
+	tarPath, err := r.spoolTarball(w, req)
+	if err != nil {
+		if mbe := (*http.MaxBytesError)(nil); errors.As(err, &mbe) {
+			writeString(w, http.StatusRequestEntityTooLarge, fmt.Sprintf("the tarball is larger than the maximum of %d bytes\n", mbe.Limit))
+		} else {
+			log.Errorf("error receiving a tarball: %s", err)
+			writeString(w, http.StatusBadRequest, "unable to receive the tarball\n")
+		}
+		return
+	}
+	defer os.Remove(tarPath)
+	resolveRef := ""
+	if params.ResolveRef != nil {
+		resolveRef = *params.ResolveRef
+	}
+	results, err := cache.LoadTarball(tarPath, resolveRef, r.imagePath, r.platformOs, r.platformArch, time.Duration(r.pullTimeout)*time.Millisecond)
+	if err != nil {
+		writeString(w, http.StatusBadRequest, err.Error()+"\n")
+		return
+	}
+	writeJSON(w, http.StatusOK, tarballResponse{Results: results})
+}
+
+// authorized returns true if the request may use an endpoint that changes the cache content:
+// with a token configured, it must have 'Authorization: Bearer <token>'. With no token, it must
+// come from the loopback address (e.g. a sidecar in the same pod): its connection's address,
+// not a client-supplied header. Otherwise it writes 401 or 403 and returns false.
+func (r *OciRegistry) authorized(w http.ResponseWriter, req *http.Request) bool {
+	if r.token == "" {
+		if host, _, err := net.SplitHostPort(req.RemoteAddr); err == nil {
+			if ip := net.ParseIP(host); ip != nil && ip.IsLoopback() {
+				return true
+			}
+		}
+		writeString(w, http.StatusForbidden, "no token is configured, so only requests from the loopback address are accepted\n")
+		return false
+	}
+	token, ok := strings.CutPrefix(req.Header.Get("Authorization"), "Bearer ")
+	if !ok || subtle.ConstantTimeCompare([]byte(token), []byte(r.token)) != 1 {
+		w.Header().Set("WWW-Authenticate", "Bearer")
+		writeString(w, http.StatusUnauthorized, "a valid bearer token is required\n")
+		return false
+	}
+	return true
+}
+
+// spoolTarball saves the request body to a new temp file in the spool directory, up to the
+// maximum tarball size, and returns its path. On error the file is removed, and an
+// *http.MaxBytesError means the body is over the maximum.
+func (r *OciRegistry) spoolTarball(w http.ResponseWriter, req *http.Request) (string, error) {
+	f, err := os.CreateTemp(r.tarballSpoolDir, "ociregistry-tarball-*")
+	if err != nil {
+		return "", err
+	}
+	_, err = io.Copy(f, http.MaxBytesReader(w, req.Body, r.maxTarballSize))
+	if cerr := f.Close(); err == nil {
+		err = cerr
+	}
+	if err != nil {
+		os.Remove(f.Name())
+		return "", err
+	}
+	return f.Name(), nil
+}
