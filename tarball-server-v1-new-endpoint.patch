+	otherV2 = mock.TarImage{Ref: "quay.io/org/other:v2", Os: "linux", Arch: "amd64", Layers: []string{"base layer", "other layer"}}
+	armV1   = mock.TarImage{Ref: "quay.io/org/arm:v1", Os: "linux", Arch: "arm64", Layers: []string{"arm layer"}}
