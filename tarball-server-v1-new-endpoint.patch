+package config
+
+import (
+	"errors"
+	"fmt"
+	"os"
+	"strconv"
+	"strings"
+)
+
+// DefaultMaxTarballSize is the largest tarball PUT /cmd/tarball accepts if maxTarballSize
+// isn't configured: 10Gi.
+const DefaultMaxTarballSize int64 = 10 << 30
+
+// sizeUnits are the suffixes parseSize accepts, as in Kubernetes quantities.
+var sizeUnits = []struct {
+	suffix string
+	mult   int64
+}{{"Ki", 1 << 10}, {"Mi", 1 << 20}, {"Gi", 1 << 30}, {"Ti", 1 << 40}}
+
+// ResolveToken returns the bearer token for PUT /cmd/tarball from whichever of token,
+// tokenFile or tokenEnv is configured, or the empty string if none is. A token file is read,
+// and an environment variable looked up, each time this is called, so the caller should call
+// it once, at startup. Leading and trailing white space is removed, so a file with a trailing
+// newline works. It's an error to configure more than one, or for the token to be empty.
+func ResolveToken() (string, error) {
+	set := 0
+	for _, v := range []string{config.Token, config.TokenFile, config.TokenEnv} {
+		if v != "" {
+			set++
+		}
+	}
+	var token string
+	switch {
+	case set == 0:
+		return "", nil
+	case set > 1:
+		return "", errors.New("only one of token, token file, or token env may be specified")
+	case config.Token != "":
+		token = config.Token
+	case config.TokenFile != "":
+		b, err := os.ReadFile(config.TokenFile)
+		if err != nil {
+			return "", fmt.Errorf("unable to read the token file: %w", err)
+		}
+		token = string(b)
+	default:
+		token = os.Getenv(config.TokenEnv)
+	}
+	if token = strings.TrimSpace(token); token == "" {
+		return "", errors.New("the configured token is empty")
+	}
+	return token, nil
+}
+
+// GetMaxTarballSize returns the largest tarball, in bytes, that PUT /cmd/tarball accepts:
+// maxTarballSize, or DefaultMaxTarballSize if it isn't configured. The value was validated
+// when the configuration was loaded.
+func GetMaxTarballSize() int64 {
+	if size, err := parseSize(config.MaxTarballSize); err == nil && size > 0 {
+		return size
+	}
+	return DefaultMaxTarballSize
+}
+
+// GetTarballSpoolDir returns the directory where PUT /cmd/tarball saves a tarball while it
+// loads it: tarballSpoolDir, or the system temp directory if it isn't configured.
+func GetTarballSpoolDir() string {
+	if config.TarballSpoolDir != "" {
+		return config.TarballSpoolDir
+	}
+	return os.TempDir()
+}
+
+// parseSize parses a size in bytes, optionally with a Ki, Mi, Gi or Ti suffix (e.g. "512Mi").
+// The empty string is zero, meaning not configured. Anything else that isn't a positive whole
+// number of bytes or units is an error.
+func parseSize(size string) (int64, error) {
+	if size == "" {
+		return 0, nil
+	}
+	num, mult := size, int64(1)
+	for _, u := range sizeUnits {
+		if n, ok := strings.CutSuffix(size, u.suffix); ok {
+			num, mult = n, u.mult
+			break
+		}
+	}
+	n, err := strconv.ParseInt(num, 10, 64)
+	if err != nil || n < 1 || n > (1<<62)/mult {
+		return 0, fmt.Errorf("invalid size %q: expected a positive number of bytes, optionally with a Ki, Mi, Gi or Ti suffix", size)
+	}
+	return n * mult, nil
+}
