#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# Returns success if $2 is strictly greater than $1, using version-aware sort.
version_gt() {
  [[ "$1" != "$2" ]] && [[ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | tail -1)" == "$2" ]]
}

CURRENT=$(go version | awk '{print $3}' | sed 's/go//')
LATEST=$(curl -fsSL "https://go.dev/VERSION?m=text" | head -1 | sed 's/^go//')

if [[ -z "$LATEST" ]]; then
  echo "Could not determine latest Go version from go.dev"
  exit 1
fi

echo "Installed: $CURRENT   Latest available: $LATEST"

if ! version_gt "$CURRENT" "$LATEST"; then
  echo "Go is already at the latest version ($CURRENT). Nothing to do."
  exit 0
fi

OS=$(go env GOOS)
ARCH=$(go env GOARCH)
TARBALL="go${LATEST}.${OS}-${ARCH}.tar.gz"
URL="https://go.dev/dl/${TARBALL}"
TMPDIR=$(mktemp -d)
trap 'rm -rf "$TMPDIR"' EXIT

echo "Downloading $URL"
curl -L -o "$TMPDIR/$TARBALL" "$URL"

echo "Installing to /usr/local/go (requires sudo)..."
sudo rm -rf /usr/local/go
sudo tar -C /usr/local -xzf "$TMPDIR/$TARBALL"

NEW_VERSION=$(/usr/local/go/bin/go version | awk '{print $3}' | sed 's/go//')
echo "Installed Go $NEW_VERSION"

GOMOD_VERSION=$(awk '/^go /{print $2}' "$script_dir/go.mod")

if version_gt "$GOMOD_VERSION" "$NEW_VERSION"; then
  echo "Golang was updated to $NEW_VERSION - run make bump-go GO_VERSION=$NEW_VERSION"
fi
